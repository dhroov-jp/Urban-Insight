# Copernicus Data Space Ecosystem / Sentinel Hub OAuth credentials.
# Get these free at https://dataspace.copernicus.eu — see the README section
# "Construction Activity Monitoring: Sentinel Hub setup" for step-by-step instructions.
SH_CLIENT_ID="your-oauth-client-id"
SH_CLIENT_SECRET="your-oauth-client-secret"

# Optional overrides — sensible defaults are set in app/config.py
# DEFAULT_LOOKBACK_DAYS=60
# DEFAULT_BASELINE_OFFSET_DAYS=180
# DEFAULT_MAX_CLOUD_COVER=20
# NDBI_CHANGE_THRESHOLD=0.15
# CORS_ORIGINS=["http://localhost:3000"]

# Live Reservoir & Lake Stock Tracker configurations
# Set this to the official BMC Hydraulic Engineer's Department report URL.
# RESERVOIR_SCRAPER_URL="https://<official-bmc-report-url>"
# RESERVOIR_DEMAND_ML_DAY=4200.0

# Live External API Keys (Urban Layers)
# TOMTOM_API_KEY="your-tomtom-traffic-api-key"
# WAQI_API_KEY="your-world-air-quality-index-token"

# NASA Earthdata credentials (for Nighttime Lighting Adequacy module)
# Register free at https://urs.earthdata.nasa.gov
# EARTHDATA_USERNAME="your-earthdata-username"
# EARTHDATA_PASSWORD="your-earthdata-password"

